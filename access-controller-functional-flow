<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Access Controller — How It Works</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --blue:    #1B4FD8;
      --blue-lt: #EEF2FF;
      --green:   #0F9C60;
      --green-lt:#ECFDF5;
      --red:     #DC2626;
      --red-lt:  #FEF2F2;
      --amber:   #D97706;
      --amber-lt:#FFFBEB;
      --purple:  #7C3AED;
      --purple-lt:#F5F3FF;
      --gray:    #64748B;
      --gray-lt: #F8FAFC;
      --border:  #E2E8F0;
      --text:    #1E293B;
      --heading: #0F172A;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: var(--text);
      background: #F1F5F9;
      line-height: 1.6;
    }

    /* ── HEADER ── */
    .page-header {
      background: linear-gradient(135deg, #0F172A 0%, #7C3AED 100%);
      color: #fff;
      padding: 48px 60px 40px;
    }
    .page-header .badge {
      display: inline-block;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.2px;
      padding: 4px 14px;
      margin-bottom: 18px;
      text-transform: uppercase;
    }
    .page-header h1 { font-size: 38px; font-weight: 800; line-height: 1.15; margin-bottom: 12px; }
    .page-header p  { font-size: 16px; opacity: 0.8; max-width: 640px; }

    /* ── LAYOUT ── */
    .container { max-width: 1100px; margin: 0 auto; padding: 48px 24px; }

    /* ── SECTION HEADERS ── */
    .section-label {
      display: flex; align-items: center; gap: 10px;
      font-size: 11px; font-weight: 700; letter-spacing: 1.4px;
      text-transform: uppercase; color: var(--purple);
      margin-bottom: 8px;
    }
    .section-label::before {
      content: ''; display: block; width: 28px; height: 2px; background: var(--purple);
    }
    h2 { font-size: 24px; font-weight: 700; color: var(--heading); margin-bottom: 24px; }
    h3 { font-size: 16px; font-weight: 700; color: var(--heading); margin-bottom: 10px; }

    /* ── CARDS ── */
    .card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 28px 32px;
      margin-bottom: 24px;
      box-shadow: 0 1px 4px rgba(0,0,0,.04);
    }

    /* ── WHAT IS ── */
    .what-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 8px;
    }
    @media(max-width:680px){ .what-grid { grid-template-columns: 1fr; } }

    .what-item {
      display: flex; gap: 14px; align-items: flex-start;
      background: var(--gray-lt);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 18px 20px;
    }
    .what-item .icon {
      width: 40px; height: 40px; border-radius: 10px;
      background: var(--purple-lt); display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 20px;
    }
    .what-item p { font-size: 14px; color: var(--gray); margin-top: 4px; }

    /* ── FLOW DIAGRAM ── */
    .flow {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .flow-step {
      display: flex;
      gap: 0;
      position: relative;
    }
    .flow-left {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 56px;
      flex-shrink: 0;
    }
    .step-circle {
      width: 40px; height: 40px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 15px; color: #fff;
      flex-shrink: 0; z-index: 1;
    }
    .step-line {
      width: 2px;
      flex: 1;
      min-height: 24px;
      background: var(--border);
      margin: 0 auto;
    }
    .flow-step:last-child .step-line { display: none; }

    .flow-body {
      flex: 1;
      padding: 0 0 28px 16px;
    }
    .flow-body .title {
      font-weight: 700; font-size: 15px; color: var(--heading);
      margin-bottom: 6px; margin-top: 8px;
    }
    .flow-body .desc { font-size: 14px; color: var(--gray); margin-bottom: 10px; }
    .flow-body .detail-box {
      background: var(--gray-lt);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 13px;
      color: var(--text);
    }
    .flow-body .detail-box code {
      background: #E2E8F0;
      border-radius: 4px;
      padding: 2px 6px;
      font-size: 12px;
      font-family: "Fira Code", "Courier New", monospace;
      color: var(--purple);
    }
    .tag {
      display: inline-block;
      border-radius: 5px;
      font-size: 11px; font-weight: 600;
      padding: 2px 8px;
      margin: 2px 2px 2px 0;
    }
    .tag-blue   { background: var(--blue-lt);  color: var(--blue); }
    .tag-green  { background: var(--green-lt); color: var(--green); }
    .tag-red    { background: var(--red-lt);   color: var(--red); }
    .tag-amber  { background: var(--amber-lt); color: var(--amber); }
    .tag-purple { background: var(--purple-lt);color: var(--purple); }

    /* ── ACTORS ── */
    .actors-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    @media(max-width:680px){ .actors-grid { grid-template-columns: 1fr; } }
    .actor-card {
      border-radius: 12px;
      padding: 20px 22px;
      border: 1px solid transparent;
    }
    .actor-card .icon { font-size: 28px; margin-bottom: 10px; }
    .actor-card p { font-size: 13px; margin-top: 6px; }
    .ac-blue   { background: var(--blue-lt);   border-color: #C7D7F9; color: var(--blue); }
    .ac-green  { background: var(--green-lt);  border-color: #A7F3D0; color: var(--green); }
    .ac-amber  { background: var(--amber-lt);  border-color: #FCD68A; color: var(--amber); }
    .ac-red    { background: var(--red-lt);    border-color: #FECACA; color: var(--red); }
    .ac-purple { background: var(--purple-lt); border-color: #DDD6FE; color: var(--purple); }
    .ac-gray   { background: var(--gray-lt);   border-color: var(--border); color: var(--gray); }

    /* ── ACTION TYPES ── */
    .vtype-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    @media(max-width:680px){ .vtype-grid { grid-template-columns: 1fr 1fr; } }
    .vtype-card {
      text-align: center; padding: 18px 12px;
      background: var(--gray-lt); border: 1px solid var(--border);
      border-radius: 10px;
    }
    .vtype-card .emoji { font-size: 30px; margin-bottom: 8px; }
    .vtype-card .name  { font-size: 13px; font-weight: 600; color: var(--heading); }
    .vtype-card .sub   { font-size: 11px; color: var(--gray); margin-top: 2px; }

    /* ── DB TABLE ── */
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    thead th {
      background: var(--purple); color: #fff;
      padding: 10px 14px; text-align: left; font-weight: 600;
    }
    thead th:first-child { border-radius: 8px 0 0 0; }
    thead th:last-child  { border-radius: 0 8px 0 0; }
    tbody tr:nth-child(even) { background: var(--gray-lt); }
    tbody td { padding: 9px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
    tbody td code {
      background: #E2E8F0; border-radius: 4px;
      padding: 1px 5px; font-size: 11px;
      font-family: "Fira Code", "Courier New", monospace;
      color: var(--purple);
    }
    .pill {
      display: inline-block; border-radius: 20px; font-size: 11px;
      font-weight: 600; padding: 2px 9px;
    }
    .pill-blue   { background: var(--blue-lt);  color: var(--blue); }
    .pill-green  { background: var(--green-lt); color: var(--green); }
    .pill-red    { background: var(--red-lt);   color: var(--red); }
    .pill-amber  { background: var(--amber-lt); color: var(--amber); }
    .pill-purple { background: var(--purple-lt);color: var(--purple); }

    /* ── ARCH TREE ── */
    .arch-tree {
      font-family: "Fira Code", "Courier New", monospace;
      font-size: 12.5px;
      background: var(--gray-lt);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px 24px;
      white-space: pre;
      overflow-x: auto;
      color: var(--text);
      line-height: 1.7;
    }
    .arch-tree .h { color: var(--purple); font-weight: 700; }

    /* ── SECURITY ── */
    .security-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    }
    @media(max-width:680px){ .security-grid { grid-template-columns: 1fr; } }
    .sec-item {
      border-left: 4px solid;
      padding: 14px 16px;
      border-radius: 0 8px 8px 0;
      background: var(--gray-lt);
    }
    .sec-item h4 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
    .sec-item p  { font-size: 13px; color: var(--gray); }
    .sec-item.blue   { border-color: var(--blue); }
    .sec-item.green  { border-color: var(--green); }
    .sec-item.red    { border-color: var(--red); }
    .sec-item.amber  { border-color: var(--amber); }
    .sec-item.purple { border-color: var(--purple); }

    /* ── NOTIFICATION ── */
    .notif-row {
      display: flex; align-items: flex-start; gap: 14px;
      padding: 14px 0; border-bottom: 1px solid var(--border);
    }
    .notif-row:last-child { border-bottom: none; }
    .notif-icon {
      width: 36px; height: 36px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 16px;
    }
    .notif-row .text p { font-size: 13px; color: var(--gray); margin-top: 3px; }

    /* ── GENIO CALLOUT ── */
    .callout {
      border-radius: 12px;
      padding: 24px 28px;
      margin-top: 8px;
    }
    .callout.blue  { background: var(--blue-lt);  border: 1px solid #C7D7F9; }
    .callout.green { background: var(--green-lt); border: 1px solid #A7F3D0; }
    .callout h3 { font-size: 15px; font-weight: 700; margin-bottom: 10px; }
    .callout ul { padding-left: 18px; font-size: 14px; color: var(--text); }
    .callout ul li { margin-bottom: 6px; }
    .callout ul li strong { color: var(--blue); }

    /* ── FOOTER ── */
    .page-footer {
      background: var(--heading); color: rgba(255,255,255,0.5);
      text-align: center; padding: 24px;
      font-size: 12px;
    }

    /* ── DIVIDER ── */
    .section-divider { height: 40px; }
  </style>
</head>
